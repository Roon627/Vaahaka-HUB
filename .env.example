# Supabase project settings -> API. Only the anon key is needed: all writes go
# through RLS policies and SECURITY DEFINER RPCs (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: override the GeoJSON source (defaults to /data/maldives-atolls.geojson)
# NEXT_PUBLIC_ATOLL_GEOJSON_URL=
