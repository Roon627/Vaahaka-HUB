# Supabase project settings -> API. Only the anon key is needed: all writes go
# through RLS policies and SECURITY DEFINER RPCs (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: override the GeoJSON source (defaults to /data/maldives-atolls.geojson)
# NEXT_PUBLIC_ATOLL_GEOJSON_URL=

# Public site URL (used for share images / metadata)
NEXT_PUBLIC_SITE_URL=https://ihusaas.online

# --- Fodibey integration (SERVER-SIDE ONLY: never prefix these with NEXT_PUBLIC_) ---------------
# Service-role key: Supabase → Project Settings → API. Lets the Fodibey API see hidden content and moderate.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token(s) Fodibey sends. Generate with: openssl rand -hex 32   (comma-separate to rotate keys)
FODIBEY_API_KEY=
# Optional: push events to Fodibey (signed with the secret; see docs/fodibey-api.md)
FODIBEY_WEBHOOK_URL=
FODIBEY_WEBHOOK_SECRET=
# Optional: salt for the hashed network address used only to rate-limit the suggestion box (any random string)
SUGGESTION_SALT=
# Optional: shared secret for the Supabase Database Webhook -> /api/fodibey/v1/relay hop
FODIBEY_RELAY_SECRET=
# Optional: browser origins allowed to call the API (prefer server-to-server)
FODIBEY_ALLOWED_ORIGINS=
